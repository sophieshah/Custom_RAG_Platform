      "enum": [
        "low",
        "moderate",
        "high",
        "unknown",
        null,
        "",
        "medium"
      ],
      "description": "Alias of pretreatment_burden; do not send conflicting values."
    },
    "sputum_smear": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "negative",
        "positive",
        "scanty",
        "1+",
        "2+",
        "3+",
        "4+",
        "unknown",
        null,
        ""
      ],
      "description": "Alias of smear; do not send conflicting values."
    },
    "cough": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
